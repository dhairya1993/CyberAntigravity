# ==============================================================================
# CyberAntigravity — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure managed database & auth credentials.
# If these variables are not provided, the server operates in local database mode
# using an ACID-compliant file store (.data/db.json) for development and offline testing.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Managed Authentication & Database: Supabase (PostgreSQL + Auth)
# ------------------------------------------------------------------------------
# Found in your Supabase Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Secret Service Role Key (Keep this secret! Never expose to client-side code):
# Required for server-side trusted XP validation and admin user synchronization:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# Session Security & Hashing
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing session tokens and cookies (min 32 chars):
SESSION_SECRET=cyberantigravity_super_secret_session_key_min_32_chars_2026

# ------------------------------------------------------------------------------
# Database Driver Mode
# ------------------------------------------------------------------------------
# Options:
#  - "auto": Use Supabase if credentials are present, otherwise use local DB
#  - "supabase": Require Supabase credentials (throws error if missing)
#  - "local": Force local ACID JSON/SQLite file store (.data/db.json)
DATABASE_MODE=auto
